/* =========================
   GLOBAL RESET
========================= */


*{
    box-sizing:border-box;
}


html,
body,
#root{

    width:100%;
    min-height:100%;

    margin:0;
    padding:0;

}


body{

    font-family:
    Arial,
    Helvetica,
    sans-serif;

    background:#f5f7fb;

    color:#222;

}


a{

    text-decoration:none;

}



/* =========================
   HEADER
========================= */


.top-header{

    height:75px;

    width:100%;

    background:#0066ff;

    display:flex;

    align-items:center;

    gap:35px;

    padding:0 50px;

}



.logo a{

    color:white;

    font-size:28px;

    font-weight:900;

}





.search-box{

    flex:1;

    max-width:750px;

    display:flex;

}



.search-box input{

    flex:1;

    height:45px;

    border:none;

    outline:none;

    padding:0 20px;

    font-size:15px;

}



.search-box button{

    width:120px;

    border:none;

    background:#ff9900;

    color:white;

    font-weight:bold;

    cursor:pointer;

}




.header-actions{

    display:flex;

    align-items:center;

    gap:25px;

}



.header-actions a{

    color:white;

    font-weight:600;

}



.sell-button{

    background:white;

    color:#0066ff!important;

    padding:12px 22px;

    border-radius:6px;

}





/* =========================
   CATEGORY MENU
========================= */


.category-bar{

    height:45px;

    background:white;

    display:flex;

    justify-content:center;

    align-items:center;

    gap:40px;

    border-bottom:1px solid #ddd;

}



.category-bar a{

    color:#333;

    font-size:14px;

    font-weight:600;

}


.category-bar a:hover{

    color:#0066ff;

}





/* =========================
   MARKETPLACE PAGE
========================= */


.marketplace-page{

    width:100%;

}



.marketplace-hero{


    max-width:1300px;

    height:300px;

    margin:25px auto;

    padding:40px;


    background:

    linear-gradient(
        135deg,
        #0066ff,
        #00aaff
    );


    border-radius:12px;


    color:white;


    display:flex;

    align-items:center;


}



.hero-content h1{

    font-size:42px;

    margin:15px 0;

}



.hero-content p{

    font-size:18px;

    max-width:500px;

}



.hero-button{

    background:white;

    color:#0066ff;

    border:none;

    padding:12px 25px;

    border-radius:8px;

    font-weight:bold;

}





/* =========================
   CATEGORY CARDS
========================= */


.category-section{

    max-width:1300px;

    margin:20px auto;

    padding:0 30px;

}



.category-grid{

    display:grid;

    grid-template-columns:
    repeat(6,1fr);

    gap:15px;

}



.category-grid div{

    background:white;

    padding:20px;

    border-radius:10px;

    text-align:center;

    font-weight:600;

    border:1px solid #eee;

}






/* =========================
   PRODUCT SECTION
========================= */


.marketplace-section{

    max-width:1300px;

    margin:auto;

    padding:30px;

}



.section-heading{

    display:flex;

    justify-content:space-between;

    align-items:center;

}



.section-heading h2{

    margin:0;

    font-size:26px;

}





.view-all{

    color:#0066ff;

}





/* =========================
   PRODUCT GRID
========================= */


.listing-grid{

    display:grid;

    grid-template-columns:
    repeat(4,1fr);

    gap:20px;

}





/* =========================
   PRODUCT CARD
========================= */


.product-card{


    background:white;

    border-radius:10px;

    overflow:hidden;

    border:1px solid #eee;

    cursor:pointer;


}



.product-card:hover{


    transform:translateY(-5px);


    box-shadow:
    0 8px 20px rgba(0,0,0,.12);


}





.product-image-container{


    width:100%;

    height:220px;

    background:#eee;

    overflow:hidden;


}




.product-image{


    width:100%;

    height:100%;

    object-fit:cover;


}





.no-image{

    height:220px;

    display:flex;

    align-items:center;

    justify-content:center;

    color:#999;

}





.product-info{

    padding:15px;

}




.product-title{

    font-size:15px;

    font-weight:600;

    height:42px;

    overflow:hidden;

    margin:0 0 10px;

}




.product-price{


    color:#0066ff;

    font-size:20px;

    font-weight:800;


}



.product-location{

    color:#555;

    font-size:14px;

}


.product-category{

    color:#888;

    font-size:13px;

}





/* =========================
   FILTER SEARCH
========================= */


.marketplace-search{


    max-width:1300px;

    margin:20px auto;

    background:white;

    padding:15px;

    border-radius:10px;

    display:flex;

    gap:10px;

}





.marketplace-search input,
.marketplace-search select{


    height:45px;

    border:1px solid #ddd;

    padding:0 15px;

    border-radius:6px;

}





.marketplace-search button{


    background:#0066ff;

    color:white;

    border:none;

    padding:0 25px;

    border-radius:6px;

}




/* =========================
   RESPONSIVE
========================= */


@media(max-width:1000px){


.listing-grid{

    grid-template-columns:
    repeat(3,1fr);

}


.category-grid{

    grid-template-columns:
    repeat(3,1fr);

}


}



@media(max-width:700px){


.top-header{

    flex-wrap:wrap;

    height:auto;

    padding:20px;

}


.header-actions{

    display:none;

}


.category-bar{

    overflow-x:auto;

    justify-content:flex-start;

    padding:0 20px;

}



.listing-grid{

    grid-template-columns:
    repeat(2,1fr);

}


.category-grid{

    grid-template-columns:
    repeat(2,1fr);

}


.marketplace-hero{

    margin:15px;

}



}




@media(max-width:450px){


.listing-grid{

    grid-template-columns:
    1fr;

}


}

/* =========================
   JUMIA PRODUCT ENHANCEMENTS
========================= */


.product-image-container{

    position:relative;

}



.discount-badge{


    position:absolute;

    top:10px;

    left:10px;

    background:#ff9900;

    color:white;

    padding:5px 10px;

    border-radius:5px;

    font-size:12px;

    font-weight:bold;

    z-index:2;

}




.wishlist-button{


    position:absolute;

    top:10px;

    right:10px;


    width:35px;

    height:35px;


    border:none;

    border-radius:50%;


    background:white;


    cursor:pointer;


    font-size:18px;


    z-index:2;


}





.product-rating{


    font-size:14px;

    margin-bottom:8px;

    color:#ff9900;

}



.product-rating span{


    color:#777;

    margin-left:5px;

}




.delivery{


    font-size:13px;

    color:#008000;

    font-weight:600;

}

.marketplace-layout{

    max-width:1300px;

    margin:auto;

    display:flex;

    gap:25px;

    padding:25px;

}



.category-sidebar{

    width:240px;

    background:white;

    padding:20px;

    border-radius:10px;

    border:1px solid #eee;

}



.category-sidebar h3{

    margin-top:0;

}



.category-item{

    margin-bottom:18px;

}



.subcategory{

    padding:6px 0 6px 15px;

    color:#666;

    font-size:14px;

}



.marketplace-content{

    flex:1;

}



@media(max-width:900px){

    .marketplace-layout{

        flex-direction:column;

    }


    .category-sidebar{

        width:100%;

    }

}
/* =========================
   CATEGORY SIDEBAR
========================= */


.marketplace-layout{

    max-width:1300px;

    margin:auto;

    display:flex;

    gap:25px;

    padding:25px;

}



.category-sidebar{

    width:240px;

    background:white;

    border-radius:10px;

    padding:20px;

    border:1px solid #eee;

    flex-shrink:0;

}



.category-sidebar h3{

    margin-top:0;

    font-size:20px;

}



.category-item{

    padding:12px 0;

    border-bottom:1px solid #eee;

}



.category-name{

    font-weight:700;

    cursor:pointer;

}



.subcategory{

    padding:6px 0 6px 15px;

    color:#666;

    font-size:14px;

}



.marketplace-content{

    flex:1;

}



@media(max-width:900px){

    .marketplace-layout{

        flex-direction:column;

    }


    .category-sidebar{

        width:100%;

    }

}
.marketplace-layout{

    display:flex;

    max-width:1400px;

    margin:auto;

    gap:20px;

    padding:20px;

}



.marketplace-content{

    flex:1;

}



/* CATEGORY SIDEBAR */

.category-sidebar{

    width:260px;

    background:white;

    border-radius:10px;

    padding:20px;

    height:max-content;

    box-shadow:
    0 2px 10px rgba(0,0,0,.08);

}



.category-sidebar h3{

    margin-top:0;

    font-size:20px;

}



.category-name{

    display:flex;

    justify-content:space-between;

    padding:12px 10px;

    cursor:pointer;

    font-weight:600;

    border-bottom:1px solid #eee;

}



.category-name:hover{

    color:#0066ff;

}



.subcategory-list{

    padding-left:15px;

    background:#f8f9fa;

}



.subcategory-item{

    padding:8px;

    font-size:14px;

    cursor:pointer;

}



.subcategory-item:hover{

    color:#0066ff;

}



@media(max-width:900px){

    .marketplace-layout{

        flex-direction:column;

    }


    .category-sidebar{

        width:100%;

    }

}
.category-sidebar{

    width:260px;

    background:white;

    border-radius:10px;

    padding:20px;

    box-shadow:
    0 2px 10px rgba(0,0,0,.08);

}



.category-sidebar h3{

    margin-top:0;

    font-size:22px;

}



.category-name{

    display:flex;

    align-items:center;

    gap:10px;

    padding:14px 10px;

    cursor:pointer;

    font-weight:600;

    border-bottom:1px solid #eee;

}



.category-name:hover,
.category-name.active{

    color:#0066ff;

    background:#f5f9ff;

}



.arrow{

    margin-left:auto;

    font-size:20px;

}



.subcategory-list{

    background:#f8f9fa;

    padding:10px 15px;

}



.subcategory-item{

    padding:8px;

    font-size:14px;

    cursor:pointer;

}



.subcategory-item:hover{

    color:#0066ff;

}

.product-card{

    cursor:pointer;

}

.featured-card{

    max-width:1300px;

    margin:30px auto;

    background:white;

    border-radius:15px;

    overflow:hidden;

    display:flex;

    cursor:pointer;

    box-shadow:
    0 10px 25px rgba(0,0,0,.08);

}



.featured-image{

    width:50%;

    height:350px;

}



.featured-image img{

    width:100%;

    height:100%;

    object-fit:cover;

}



.featured-info{

    padding:40px;

}



.featured-info span{

    color:#0066ff;

    font-weight:bold;

}



.featured-info h1{

    font-size:38px;

}



.featured-info h2{

    color:#0066ff;

}



.featured-info button{

    background:#0066ff;

    color:white;

    border:none;

    padding:12px 25px;

    border-radius:8px;

}



@media(max-width:700px){

.featured-card{

    flex-direction:column;

}


.featured-image{

    width:100%;

}


}

/* ==========================
 PRODUCT DETAILS PAGE
========================== */


.product-page{

    max-width:1300px;

    margin:30px auto;

    padding:20px;

}




.product-container{

    background:white;

    border-radius:15px;

    display:flex;

    gap:40px;

    padding:30px;

}





.product-gallery{

    width:50%;

}




.main-product-image{

    height:450px;

    background:#f5f5f5;

    border-radius:12px;

    overflow:hidden;

}




.main-product-image img{

    width:100%;

    height:100%;

    object-fit:contain;

}





.thumbnail-list{

    display:flex;

    gap:10px;

    margin-top:15px;

}





.thumbnail{

    width:70px;

    height:70px;

    object-fit:cover;

    border-radius:8px;

    cursor:pointer;

    border:2px solid transparent;

}




.thumbnail.active{

    border-color:#0066ff;

}







.product-information{

    flex:1;

}



.product-information h1{

    font-size:32px;

    margin-top:0;

}





.rating-box{

    color:#ff9900;

}



.rating-box span{

    color:#555;

    margin-left:10px;

}





.product-details-price{

    color:#0066ff;

    font-size:32px;

}





.action-buttons{

    display:flex;

    gap:15px;

    margin-top:30px;

}





.buy-button,
.chat-button{


    padding:15px 35px;

    border:none;

    border-radius:8px;

    font-weight:bold;

    cursor:pointer;

}



.buy-button{

    background:#ff9900;

    color:white;

}



.chat-button{

    background:#0066ff;

    color:white;

}






.description-card,
.seller-card{


    margin-top:25px;

    background:white;

    padding:30px;

    border-radius:15px;


}







@media(max-width:800px){


.product-container{

    flex-direction:column;

}



.product-gallery{

    width:100%;

}


}

/* =========================
   SEARCH RESULTS
========================= */

.search-results-header {
    max-width: 1300px;
    margin: 25px auto 5px;
    padding: 0 30px;
}

.search-results-header h2 {
    margin: 0 0 5px;
    font-size: 26px;
}

.search-results-header p {
    margin: 0;
    color: #666;
}


/* =========================
   EMPTY SEARCH
========================= */

.empty-search {
    background: white;
    border-radius: 15px;
    padding: 70px 30px;
    text-align: center;
    border: 1px solid #eee;
}

.empty-search-icon {
    font-size: 50px;
    margin-bottom: 15px;
}

.empty-search h2 {
    margin: 0 0 10px;
    font-size: 28px;
}

.empty-search p {
    color: #666;
    margin: 6px 0;
}