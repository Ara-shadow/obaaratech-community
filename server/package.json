{
  "name": "obaaratech-community-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
  "dev": "tsx watch src/server.ts",
  "build": "esbuild src/server.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/server.js --packages=external",
  "start": "node dist/server.js",
  "prisma:generate": "prisma generate",
  "prisma:deploy": "prisma migrate deploy"
},
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/env": "^5.0.2",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.3",
    "@prisma/client": "^5.15.0",
    "@prisma/engines": "^7.10.0",
    "@sconyema/paystack-js": "^0.1.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.0.0",
    "fastify-plugin": "^6.0.0",
    "multer": "^2.2.0",
    "paystack-sdk-node": "^0.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "prisma": "^5.15.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
